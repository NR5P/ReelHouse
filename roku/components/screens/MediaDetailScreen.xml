<?xml version="1.0" encoding="utf-8" ?>
<!--
  A movie or a show (GET /api/media/items/{id}). Movies: Resume / Play from Beginning, Mark
  Watched, My List, cast and file details. Shows: play the next episode, Mark Watched, My List,
  and the seasons with their episodes (OK plays one; * marks it watched/unwatched).
-->
<component name="MediaDetailScreen" extends="BaseScreen">
    <script type="text/brightscript" uri="pkg:/components/lib/Util.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Mappers.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Net.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/MediaDetailScreen.brs" />
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.3" loadWidth="1280" loadHeight="720" />
        <Rectangle width="1920" height="1080" color="0x0E0A1299" />
        <Rectangle id="posterCard" translation="[96,150]" width="300" height="450" color="0x1F1629FF" />
        <Poster id="poster" translation="[96,150]" width="300" height="450" loadDisplayMode="scaleToZoom" loadWidth="300" loadHeight="450" />
        <Label id="title" translation="[440,140]" width="1380" color="0xF4E9DAFF" font="font:LargeBoldSystemFont" />
        <Label id="meta" translation="[440,214]" width="1380" color="0xA99A8EFF" font="font:MediumSystemFont" />
        <Label id="tagline" translation="[440,264]" width="1380" color="0xFFC24BFF" font="font:SmallSystemFont" />
        <Label id="overview" translation="[440,310]" width="1380" wrap="true" maxLines="5" color="0xF4E9DAFF" font="font:SmallSystemFont" />
        <Label id="cast" translation="[440,640]" width="1380" wrap="true" maxLines="3" color="0xA99A8EFF" font="font:SmallSystemFont" />
        <Label id="fileInfo" translation="[440,780]" width="1380" color="0xA99A8EFF" font="font:SmallestSystemFont" />
        <Label id="error" translation="[440,860]" width="1380" wrap="true" maxLines="3" color="0xE23D3DFF" font="font:SmallBoldSystemFont" />

        <ButtonGroup id="buttons" translation="[96,640]" />

        <Group id="showPanel" visible="false">
            <Label text="SEASONS" translation="[440,560]" color="0xFFC24BFF" font="font:SmallBoldSystemFont" />
            <LabelList id="seasons" translation="[440,610]" itemSize="[300,64]" numRows="6" color="0xF4E9DAFF" focusedColor="0x0E0A12FF"
                focusBitmapUri="pkg:/images/button_focus.9.png" focusFootprintBitmapUri="pkg:/images/button_footprint.9.png"
                vertFocusAnimationStyle="floatingFocus" />
            <Label id="episodesTitle" text="EPISODES" translation="[780,560]" color="0xFFC24BFF" font="font:SmallBoldSystemFont" />
            <MarkupList id="episodes" translation="[780,610]" itemComponentName="ListRowItem" itemSize="[1044,132]" itemSpacing="[0,10]"
                numRows="3" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
        </Group>
        <Label id="loading" translation="[440,320]" width="1380" text="Loading..." color="0xA99A8EFF" font="font:MediumSystemFont" />
    </children>
</component>
