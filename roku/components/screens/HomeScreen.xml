<?xml version="1.0" encoding="utf-8" ?>
<!--
  Home: one RowList with Continue Watching / Listening, recently added, Movies, TV Shows, Music
  and Podcasts rows and a Browse row (every section, Settings). Rows for a section that is off
  on the server, or empty, are left out. OK opens a tile, Play starts it, * opens Settings.
-->
<component name="HomeScreen" extends="BaseScreen">
    <script type="text/brightscript" uri="pkg:/components/lib/Util.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Mappers.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Net.brs" />
    <script type="text/brightscript" uri="pkg:/components/lib/Ui.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
    <children>
        <BrandHeader id="header" hint="OK open  ·  PLAY starts  ·  * Settings" />
        <RowList id="rows" translation="[96,150]" itemComponentName="PosterItem" numRows="2"
            itemSize="[1824,480]" itemSpacing="[0,24]" rowItemSpacing="[[28,0]]" rowLabelOffset="[[0,14]]"
            showRowLabel="[true]" rowLabelColor="0xFFC24BFF" rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="false" vertFocusAnimationStyle="fixedFocus" rowFocusAnimationStyle="floatingFocus" />
        <Label id="message" translation="[160,420]" width="1600" horizAlign="center" wrap="true" maxLines="5" color="0xA99A8EFF" font="font:MediumSystemFont" />
    </children>
</component>
