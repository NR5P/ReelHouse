[Unit]
Description=ReelHouse downloads: qBittorrent (inside the VPN)
PartOf=reelhouse-downloads.target
# No VPN, no qBittorrent: stopping or losing the tunnel stops this too.
BindsTo=reelhouse-vpn.service
After=reelhouse-vpn.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
NetworkNamespacePath=/run/netns/rhvpn
BindReadOnlyPaths=/etc/netns/rhvpn/resolv.conf:/etc/resolv.conf /etc/netns/rhvpn/nsswitch.conf:/etc/nsswitch.conf
Environment=HOME=/var/lib/reelhouse-downloads/qbittorrent
ExecStart=/usr/bin/qbittorrent-nox --confirm-legal-notice --profile=/var/lib/reelhouse-downloads/qbittorrent --webui-port=8080
UMask=0002
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
SyslogIdentifier=reelhouse-qbittorrent
