<Project>
  <!-- One version for every project under server/. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReelHouseBuildNumber)' != ''">
    <AssemblyMetadata Include="BuildNumber" Value="$(ReelHouseBuildNumber)" />
  </ItemGroup>
  <!-- Six SixLabors.ImageSharp 3.1.12 advisories (2026-10) whose only fix is 3.2/4.x - which need a
       paid Six Labors license key to compile in Release. Every one is unreachable here:
       SafeImageDecoding registers no TIFF decoder, nothing encodes TIFF, and nothing reads
       IccProfile.Entries. Suppressed by advisory URL, not by NU190x code, so any NEW advisory
       still fails the build. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
  </ItemGroup>
</Project>
